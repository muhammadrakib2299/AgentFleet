# --- Required -----------------------------------------------------------
# Anthropic API key (https://platform.claude.com) — the app fails fast without it
ANTHROPIC_API_KEY=sk-ant-...

# --- Infrastructure (docker-compose defaults work out of the box) --------
POSTGRES_URL=postgresql+asyncpg://agentfleet:agentfleet@localhost:5432/agentfleet
REDIS_URL=redis://localhost:6379/0

# --- Postgres container bootstrap ----------------------------------------
POSTGRES_USER=agentfleet
POSTGRES_PASSWORD=agentfleet
POSTGRES_DB=agentfleet

# --- App ------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:5173
